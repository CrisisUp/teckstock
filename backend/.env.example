# TechStock — Backend .env.example
# Copie para .env e ajuste. NUNCA commite o .env real.
# Em produção as variáveis vêm do AWS Secrets Manager (TECHSTOCK_SECRET_NAME);
# o .env local serve apenas para desenvolvimento (sem secret configurado).

PORT=3000

# PostgreSQL / RDS
# Porta padrão 5432 (local e RDS). Se o seu Postgres local usar outra porta, ajuste.
DB_HOST=localhost
DB_PORT=5432
DB_NAME=techstock
DB_USER=techstock_user
DB_PASSWORD=substitua_por_senha_forte
DB_POOL_MIN=1
DB_POOL_MAX=5
DB_SSL=false

# AWS Secrets Manager (em produção o backend lê o secret e preenche o resto)
AWS_REGION=us-east-1
TECHSTOCK_SECRET_NAME=

# API Key opcional (se definida, o backend exige header x-api-key)
API_KEY=

# CORS — origens permitidas separadas por vírgula (sem barra no final)
CORS_ORIGIN=http://localhost:3000

# Ambiente
NODE_ENV=development
