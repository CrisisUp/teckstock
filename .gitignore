# ── Node.js ──────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# ── Playwright (testes E2E) ─────────────────────────────────────────────────
# Artefatos de execução — regenerados a cada run, não versionar
e2e/test-results/
e2e/playwright-report/
e2e/.last-run.json

# ── Terraform ────────────────────────────────────────────────────────────────
# Diretórios e estado NÃO devem ir pro git (contêm dados sensíveis de infra)
**/.terraform/
*.tfstate
*.tfstate.*
*.tfvars
# (terraform/.terraform.lock.hcl e os .tf são versionados — NÃO ignorar)

# ── Segredos & credenciais ──────────────────────────────────────────────────
# Nunca commitar .env real (apenas .env.example é versionado)
.env
.env.local
*.pem
*.key
*.p12
*.pfx
*.crt
*.id_rsa
*.id_ed25519
.aws/

# ── Arquivos gerados em deploy ───────────────────────────────────────────────
# NOTA: frontend/config.js agora é VERSIONADO como default (localhost).
# Em produção o setup-frontend.sh sobrescreve com a URL do ALB.

# ── Logs ─────────────────────────────────────────────────────────────────────
*.log

# ── IDE / Editor ─────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo

# ── Sistema operacional ──────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini
